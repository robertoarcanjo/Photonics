   "source": [
    "import numericalsolver as ns\n",
    "\n",
    "slab = ns.NumericalSolver(\"input_problems/standard_slab.json\")\n",
    "eta_eff, Ex = slab.solve()\n",
    "grid = slab.createGrid()\n",
    "eta = slab.waveguideGeometry(grid)\n",
    "slab.showWaveguideGeometry(eta, grid)"
   ]
